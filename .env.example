# Copier en .env puis remplir. Ne jamais commiter le .env.

# Généré par : make keys
DJANGO_SECRET_KEY=
# Chiffre les mots de passe vCenter / Proxmox / AD / BMC en base. À SAUVEGARDER : sans elle, les secrets sont perdus.
APP_ENCRYPTION_KEY=

DJANGO_ALLOWED_HOSTS=inventaire.euro.net.intra,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://inventaire.euro.net.intra
DJANGO_DEBUG=0
TZ=Europe/Paris
SESSION_HOURS=8

# Compte administrateur local créé au premier démarrage (accès de secours si l'AD est indisponible)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0

# Nombre de sources collectées en parallèle par conteneur worker
COLLECT_CONCURRENCY=16

# Disque de données (PostgreSQL + historique Excel). Le sous-dossier history/ doit appartenir à l'UID 1000.
DATA_DIR=/srv/inventaire
HISTORY_DIR=/data/history
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE=12GB
WEB_WORKERS=4

# Miroirs internes pour la construction de l'image (facultatif)
# PIP_INDEX_URL=https://artifactory.euro.net.intra/artifactory/api/pypi/pypi-remote/simple
# VENDOR_BASE=https://artifactory.euro.net.intra/artifactory/api/npm/npm-remote
